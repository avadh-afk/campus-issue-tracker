# Local development settings. Copy to .env; never commit .env or real secrets.
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional storage paths. Use absolute paths on a persistent volume in production.
# DB_FILE=/var/data/campusfix.db
# UPLOAD_DIR=/var/data/uploads

# Production-only first administrator bootstrap. Use an email you control and a unique password
# of at least 16 characters. Set these as Render Environment Variables, not in GitHub.
# ADMIN_NAME=CampusFix Administrator
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters

# Non-production only. Set to false to skip seeded demo accounts.
# SEED_DEMO_USERS=true
